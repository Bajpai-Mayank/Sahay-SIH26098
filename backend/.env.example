# ==========================================
# SAHAY-AI Backend Environment Configuration
# ==========================================

# Application Settings
APP_NAME=SAHAY-AI
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000,http://127.0.0.1:8000

# Database (PostgreSQL / Supabase)
# For Local PostgreSQL:
DATABASE_URL=postgresql+asyncpg://sahay_user:sahay_password@localhost:5432/sahay_db
# For Supabase PostgreSQL (via transaction pooler port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Cache & Rate Limiting (Redis / Upstash)
# For Local Redis:
REDIS_URL=redis://localhost:6379/0
# For Upstash Serverless Redis:
# REDIS_URL=rediss://default:[YOUR_PASSWORD]@[YOUR_ENDPOINT].upstash.io:6379

# Authentication & Security
JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase Auth, DB & Storage (Optional, if using Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# AI Orchestration
# Supported providers: mock | gemini | ollama | huggingface
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
AI_SAFETY_STRICT=true
AI_TIMEOUT_SECONDS=30
AI_FALLBACK_TO_MOCK=true

# Google Gemini API Settings (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Hugging Face Settings (Get from https://huggingface.co/settings/tokens)
HF_TOKEN=

# Ollama Local Server Settings (Local inference: https://ollama.com/)
OLLAMA_BASE_URL=http://localhost:11434

# Object Storage (Local / Supabase / S3-compatible)
STORAGE_BACKEND=local
STORAGE_PATH=./storage_data
STORAGE_BUCKET=audio-checkins
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
