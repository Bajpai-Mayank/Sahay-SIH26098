# ==========================================
# SAHAY-AI Backend Environment Configuration
# ==========================================
# Copy this file to backend/.env and populate with your credentials.
# NEVER commit your backend/.env file to Git!

# APPLICATION
APP_NAME=SAHAY-AI
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000,http://127.0.0.1:8000,http://localhost:8000

# DATABASE (PostgreSQL / Supabase)
# For Direct Connection (using your Supabase host):
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_PASSWORD]@db.ooqaehsxxmzkwgizwwwc.supabase.co:5432/postgres
# For Supabase Transaction Pooler (Port 6543 - recommended if direct connection is blocked):
# DATABASE_URL=postgresql+asyncpg://postgres.ooqaehsxxmzkwgizwwwc:[YOUR_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# SUPABASE (Optional - for Supabase Auth, DB & Storage)
SUPABASE_URL=https://ooqaehsxxmzkwgizwwwc.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Backward compatibility aliases:
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# REDIS & UPSTASH (Optional - rate limiting & temporary caching)
# For Local Redis:
# REDIS_URL=redis://localhost:6379/0
# For Upstash Serverless Redis:
# REDIS_URL=rediss://default:[YOUR_PASSWORD]@[YOUR_ENDPOINT].upstash.io:6379
# UPSTASH_REDIS_REST_URL=https://[YOUR_ENDPOINT].upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# AI ORCHESTRATION
# Options: mock | gemini | kimi | ollama | huggingface
# The backend defaults to 'mock' and runs 100% offline without any API keys!
AI_PROVIDER=mock
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=30
AI_FALLBACK_TO_MOCK=true
AI_SAFETY_STRICT=true

# GOOGLE GEMINI (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# NVIDIA NIM / KIMI K3 (Get key from https://build.nvidia.com/)
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
KIMI_K3_MODEL=moonshotai/kimi-k3

# OLLAMA (Local offline LLM: https://ollama.com/)
OLLAMA_BASE_URL=http://localhost:11434

# HUGGING FACE (Optional: https://huggingface.co/settings/tokens)
HF_TOKEN=

# OBJECT STORAGE
# Options: local | supabase
STORAGE_BACKEND=local
STORAGE_PATH=./storage_data
STORAGE_BUCKET=audio-checkins

# SECURITY & JWT
JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
