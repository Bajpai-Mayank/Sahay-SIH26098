# ==========================================
# SAHAY-AI Backend Environment Configuration
# ==========================================

# Application Settings
APP_NAME=SAHAY-AI
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://sahay_user:sahay_password@localhost:5432/sahay_db

# Cache & Rate Limiting (Redis)
REDIS_URL=redis://localhost:6379/0

# Authentication & Security
JWT_SECRET_KEY=change_this_to_a_cryptographically_secure_random_string_32_bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Orchestration
# Supported providers: mock | ollama | gemini | huggingface
AI_PROVIDER=mock
AI_MODEL=
AI_SAFETY_STRICT=true
AI_TIMEOUT_SECONDS=30
AI_FALLBACK_TO_MOCK=true

# Ollama Settings (Optional, for local models)
OLLAMA_BASE_URL=http://localhost:11434

# Gemini API Settings (Optional, NEVER expose to client)
GEMINI_API_KEY=

# Hugging Face Settings (Optional, NEVER expose to client)
HF_TOKEN=

# Object Storage (Local / S3-compatible)
STORAGE_BACKEND=local
STORAGE_PATH=./storage_data
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
